# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ...except this one: `music-quiz/vite.config.ts` imports it, so a fresh clone
# cannot build without it. The name collides with the generic `build/` rule
# above; it is source, not output.
!music-quiz/build/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS files
.DS_Store
Thumbs.db
*.log

# The three files a host edits in the project root. The launcher creates them
# from the copies under data/ on first run. They are one host's setlist for one
# event, not a change to the project — so they are ignored, and the versioned
# originals in data/ stay the thing a fresh clone gets.
/곡목록.txt
/playlist.txt
/속담.json
/proverbs.json
/사자성어.json
/idioms.json

# Local multi-agent worktrees
.worktrees/
.scxenv/
music-quiz/dev-server*.log
music-quiz/.wrangler/

