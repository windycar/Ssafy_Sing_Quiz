# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ...except this one: `music-quiz/vite.config.ts` imports it, so a fresh clone
# cannot build without it. The name collides with the generic `build/` rule
# above; it is source, not output.
!music-quiz/build/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS files
.DS_Store
Thumbs.db
*.log

# The folder a host edits: 문제/곡목록.txt, 문제/속담.json, 문제/사자성어.json.
# The launcher creates them from the copies under data/ on first run. They are
# one host's setlist for one event, not a change to the project — so they are
# ignored, and the versioned originals in data/ stay what a fresh clone gets.
/문제/
# Where the launcher looked for a song list before 문제/ existed.
/playlist.txt

# Local multi-agent worktrees
.worktrees/
.scxenv/
music-quiz/dev-server*.log
music-quiz/.wrangler/

